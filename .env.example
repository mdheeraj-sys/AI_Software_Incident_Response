# =============================================================================
#  Autonomous AI Incident Response Agent - Environment Variables Template
# =============================================================================

# n8n Autonomous Incident Response Agent Webhook URL
# Replace with your own active n8n instance webhook URL:
N8N_WEBHOOK_URL=https://craftsman.app.n8n.cloud/webhook/incident-alert

# Secret Header for n8n Webhook Header Auth (Leave empty if Authentication is set to None)
N8N_HEADER_NAME=
N8N_HEADER_VALUE=

# Attacker Source IP (Default: auto-detected from machine's public egress IP)
HACKER_REAL_IP=119.235.52.196

# OpenRouter Free LLM API Key (used for parallel in-browser forensic triage)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
