    {
      "parameters": {
        "description": "Look up the security runbook procedure for an incident type. Input: the incident type, e.g. brute_force, ddos, error_spike, sql_injection.",
        "jsCode": "const runbook = {\n  brute_force: 'Many failed logins from one IP. Recommended: block_ip for the source IP; if the source is distributed, rate_limit the endpoint.',\n  credential_stuffing: 'Failed logins across many accounts. Recommended: rate_limit the login endpoint and block_ip for the worst offenders.',\n  ddos: 'Traffic flood. Recommended: rate_limit the endpoint; block_ip if one source dominates.',\n  sql_injection: 'Injection patterns in requests. Recommended: block_ip for the source and review the endpoint.',\n  error_spike: 'Sudden 5xx increase. Check recent deployments first; if a release matches the start time, recommend rollback_deploy.',\n  latency_spike: 'Latency regression. Check recent deployments; rollback_deploy if a release matches, otherwise monitor.'\n};\nconst key = String(query || '').toLowerCase().trim().replace(/[\\s-]+/g, '_');\nfor (const k of Object.keys(runbook)) {\n  if (key.includes(k)) return k + ': ' + runbook[k];\n}\nreturn 'No exact runbook entry for \"' + query + '\". Default procedure: gather evidence, prefer monitor unless there is clear malicious traffic (block_ip / rate_limit) or a correlated bad release (rollback_deploy).';"
      },
      "id": "a5298f54-50b3-49cc-bdbf-9f28fe9c470f",
      "name": "check_security_runbook",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        352,
        336
      ]
    },
    {
      "parameters": {
        "description": "Returns the most recent code deployments (mock data for testing). Input: optional service name or leave empty.",
        "jsCode": "const now = Date.now();\nconst iso = (minsAgo) => new Date(now - minsAgo * 60000).toISOString();\nconst deployments = [\n  { deployment_id: 'dep-1043', service: 'auth-api', version: 'v2.14.1', deployed_at: iso(25), deployed_by: 'ci-bot', status: 'success', changes: 'Refactored login session handling' },\n  { deployment_id: 'dep-1042', service: 'payments-api', version: 'v5.3.0', deployed_at: iso(180), deployed_by: 'priya', status: 'success', changes: 'Added retry logic to payment gateway client' },\n  { deployment_id: 'dep-1041', service: 'web-frontend', version: 'v8.0.2', deployed_at: iso(720), deployed_by: 'ci-bot', status: 'success', changes: 'UI copy fixes' }\n];\nreturn JSON.stringify({ source: 'mock', deployments });"
      },
      "id": "74a108e5-d3e0-4416-b864-8e2cacf0c4b6",
      "name": "get_recent_deployments",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        480,
        336
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"incident_type\": { \"type\": \"string\" },\n    \"root_cause\": { \"type\": \"string\" },\n    \"confidence\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 1, \"description\": \"Your honest confidence between 0.0 and 1.0\" },\n    \"evidence\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"proposed_action\": { \"type\": \"string\", \"enum\": [\"block_ip\", \"rate_limit\", \"rollback_deploy\", \"monitor\"] },\n    \"target_ip\": { \"type\": \"string\", \"description\": \"Only for block_ip or rate_limit; empty string otherwise\" },\n    \"deployment_id\": { \"type\": \"string\", \"description\": \"Only for rollback_deploy: the deployment to roll back; empty string otherwise\" },\n    \"requires_human_approval\": { \"type\": \"boolean\" }\n  },\n  \"required\": [\"incident_type\", \"root_cause\", \"confidence\", \"evidence\", \"proposed_action\", \"requires_human_approval\"]\n}"
      },
