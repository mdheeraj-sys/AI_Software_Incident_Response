      "id": "9f86e19e-21b1-4651-bf15-bc4da2da59a2",
      "name": "Call On-Call Engineer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1200,
        -176
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Investigate the following incident alert:\nIncident Type: {{ $json.incident_type ?? 'unknown' }}\nTarget Endpoint: {{ $json.endpoint ?? '/unknown' }}\nSuspected IP: {{ $json.source_ip ?? 'N/A' }}\nAnomaly Score: {{ $json.anomaly_score ?? 'N/A' }}\nError Count: {{ $json.error_count ?? 'N/A' }}\n\nStep 1: Check the security runbook for recommended procedure.\nStep 2: Inspect recent deployments to see if this was triggered by a bad code release.\nStep 3: Output your Root Cause Analysis (RCA) and state clearly what mitigation action should be taken : 'block_ip', 'rate_limit', 'rollback_deploy', or 'monitor' if the evidence does not justify an active mitigation.",
        "hasOutputParser": true,
        "needsFallback": true,
        "options": {
          "systemMessage": "You are Holmes-Sec, an autonomous Incident Response and SRE AI Agent.\nYour job is to investigate incoming application incidents, query bounded tools for evidence, identify the root cause, and formulate a mitigation proposal.\n\nTools:\n- check_security_runbook: returns the runbook procedure for an incident type.\n- get_recent_deployments: returns recent code deployments.\n\nproposed_action must be exactly one of: block_ip, rate_limit, rollback_deploy, monitor.\nSet requires_human_approval to true for any action other than monitor.\nChoose monitor when evidence is weak or inconclusive.\nFill target_ip only for block_ip or rate_limit, using the suspected IP from the alert.\nFill deployment_id only for rollback_deploy, using the id returned by get_recent_deployments.\nReport confidence honestly as a number between 0.0 and 1.0 based on the evidence you found."
        }
      },
      "id": "c8bcc663-31bf-4482-8394-92ef65f18871",
      "name": "Incident Investigation Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        352,
        112
      ]
    },
