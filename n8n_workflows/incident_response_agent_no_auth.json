    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "incident_type",
              "name": "incident_type",
              "type": "string",
              "value": "={{ (() => { const t = String($json.body.incident_type ?? '').toLowerCase().trim().replace(/[\\s-]+/g, '_'); return ['brute_force', 'credential_stuffing', 'ddos', 'sql_injection', 'error_spike', 'latency_spike'].includes(t) ? t : 'unknown'; })() }}"
            },
            {
              "id": "endpoint",
              "name": "endpoint",
              "type": "string",
              "value": "={{ String($json.body.endpoint ?? '/unknown').replace(/[^A-Za-z0-9_.\\/-]/g, '').slice(0, 200) || '/unknown' }}"
            },
            {
              "id": "source_ip",
              "name": "source_ip",
              "type": "string",
              "value": "={{ (() => { const ip = String($json.body.source_ip ?? '').trim(); const ok = /^(\\d{1,3}\\.){3}\\d{1,3}$/.test(ip) && ip.split('.').every(o => Number(o) <= 255); return ok ? ip : 'N/A'; })() }}"
            },
            {
              "id": "anomaly_score",
              "name": "anomaly_score",
              "type": "string",
              "value": "={{ Number.isFinite(Number($json.body.anomaly_score)) && $json.body.anomaly_score !== null && $json.body.anomaly_score !== '' ? String(Number($json.body.anomaly_score)) : 'N/A' }}"
            },
            {
              "id": "error_count",
              "name": "error_count",
              "type": "string",
              "value": "={{ Number.isFinite(Number($json.body.error_count)) && $json.body.error_count !== null && $json.body.error_count !== '' ? String(Number($json.body.error_count)) : 'N/A' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "debc1128-499e-42a6-8b39-8018853c114f",
      "name": "Sanitize Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        304
      ]
    },
    {
      "parameters": {
        "url": "http://api.callmebot.com/start.php",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "user",
              "value": "@Vishnu130507"
            },
            {
              "name": "text",
              "value": "={{ (\"Incident alert. \" + String($json.incident_type).replace(/_/g, \" \") + \" on endpoint \" + String($json.endpoint) + \". Source I P \" + String($json.source_ip) + \". The A I agent is investigating. Check Telegram for the approval request.\").slice(0, 250) }}"
            },
            {
              "name": "lang",
              "value": "en-GB-Standard-B"
            },
            {
              "name": "rpt",
              "value": "2"
            },
            {
              "name": "cc",
              "value": "missed"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
